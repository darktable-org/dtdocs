msgstr "(நிறுத்தப்பட்ட) பயிர் மற்றும் சுழற்சி"

#. type: Plain text
#: content/module-reference/processing-modules/crop-rotate.md
#, fuzzy, no-wrap
msgid ""
"description\n"
": change the framing and correct the perspective.\n"
msgstr ""
