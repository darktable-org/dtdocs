msgid "bloom"
msgstr "பூக்கும்"

#. type: Plain text
#: content/module-reference/processing-modules/bloom.md
#, fuzzy, no-wrap
msgid ""
"description\n"
": apply Orton effect for a dreamy ethereal look.\n"
msgstr ""
"விளக்கம் \n"
": ஒரு கனவான தோற்றத்திற்கு ஆர்டன் விளைவைப் பயன்படுத்துங்கள்.\n"

#. type: Plain text
#: content/module-reference/processing-modules/bloom.md
#, fuzzy, no-wrap
msgid "Create a soft bloom effect. \n"
